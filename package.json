{
  "name": "bento-web",
  "version": "0.1.0",
  "private": true,
  "description": "Le carnet: the Bento Solutions blog, served at bento212.com/blog",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --port 3010",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=4096\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start --port 3010",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NODE_OPTIONS=--no-deprecation vitest run",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/seed.ts"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/email-nodemailer": "3.92.1",
    "@payloadcms/live-preview-react": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/plugin-redirects": "3.92.1",
    "@payloadcms/plugin-seo": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/translations": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "cross-env": "10.1.0",
    "graphql": "16.14.0",
    "next": "16.4.5",
    "next-intl": "4.14.9",
    "payload": "3.92.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "16.4.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "pg": "8.23.1",
    "sass": "1.107.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
