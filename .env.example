# Copy to .env for local development.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5440/bento_web
PAYLOAD_SECRET=local-dev-secret-change-me-in-production
PREVIEW_SECRET=local-dev-preview-secret

# Public origin of the blog. No trailing slash.
SITE_URL=http://localhost:3010

# Host that serves /admin and /api. Leave empty locally: one host serves everything.
CMS_HOST=
# Origin of the admin, used for login cookies and links in emails.
CMS_URL=http://localhost:3010

# Set to 1 on the dev environment so nothing gets indexed.
SITE_NOINDEX=

# Where uploads are stored. A Docker volume in production.
MEDIA_DIR=./media

# Optional. Without SMTP_HOST, review notifications are only logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Le carnet Bento <blog@bento212.com>

# Accounts created by `npm run seed`. Development only: the seed refuses to run in production.
SEED_ADMIN_EMAIL=admin@bento.test
SEED_EDITOR_EMAIL=editor@bento.test
SEED_AUTHOR_EMAIL=author@bento.test
SEED_PASSWORD=local-dev-password
